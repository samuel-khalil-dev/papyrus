# Copy this file to .env for local Compose deployments and fill in real values.
# Never commit a .env file. The Compose file fails at startup when a required
# value is missing. See docs/06-operations/deployment-guide.md.

# PostgreSQL
POSTGRES_USER=papyrus
# Required: choose a strong, unique password.
POSTGRES_PASSWORD=change-me

# Admin API key. Required: replace with a long random value in production.
ADMIN_API_KEY=change-me

# Absolute public origins. Required for Blog and Portfolio services.
BLOG_PUBLIC_BASE_URL=https://blog.example.com
PORTFOLIO_PUBLIC_BASE_URL=https://portfolio.example.com
MEDIA_BASE_URL=https://admin.example.com

# Optional overrides (defaults shown)
# ASPNETCORE_ENVIRONMENT=Production
# ADMIN_PORT=5205
# BLOG_PORT=5075
# PORTFOLIO_PORT=5024
# PAPYRUS_ADMIN_IMAGE=papyrus-admin:local
# PAPYRUS_BLOG_IMAGE=papyrus-blog:local
# PAPYRUS_PORTFOLIO_IMAGE=papyrus-portfolio:local
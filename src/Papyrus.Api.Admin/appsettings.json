{
  "AllowedHosts": "*",
  "AdminApi": {
    "HeaderName": "X-Admin-Api-Key"
  },
  "Media": {
    "RootPath": "wwwroot/media",
    "RequestPath": "/media",
    "MaxFileBytes": 5242880,
    "MaxWidth": 10000,
    "MaxHeight": 10000,
    "MaxPixels": 40000000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}

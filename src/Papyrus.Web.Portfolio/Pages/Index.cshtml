@page
@model IndexModel
@{
    ViewData["Title"] = "Portfolio";
    var hasFilters = !string.IsNullOrWhiteSpace(Model.SearchTerm) || !string.IsNullOrWhiteSpace(Model.Tag);
}

<section class="hero-section">
    <img class="hero-section__logo" src="~/images/Papyrus_Logo.svg" alt="" aria-hidden="true" />
    <div class="hero-section__content">
        <span class="hero-section__eyebrow">Professional showcase</span>
        <h1 class="hero-section__title">Portfolio</h1>
        <p class="hero-section__subtitle">Curated development and DevOps projects that are meant for professional presentation.</p>
    </div>
    <div class="hero-section__glow" aria-hidden="true"></div>
</section>

<form method="get" class="filter-bar" aria-label="Filter projects">
    <div class="filter-bar__inner">
        <div class="filter-bar__search">
            <svg class="filter-bar__icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input type="text" name="q" value="@Model.SearchTerm" placeholder="Search projects..." aria-label="Search projects" class="filter-bar__input" autocomplete="off" />
        </div>
        <div class="filter-bar__tags">
            @foreach (var tag in Model.Tags)
            {
                    <a asp-page="/Index" asp-route-tag="@tag.Slug" asp-route-q="@Model.SearchTerm"
                       class="filter-bar__tag @(Model.Tag == tag.Slug || Model.Tag == tag.Name ? "filter-bar__tag--active" : "")">@tag.Name</a>
            }
        </div>
    </div>
</form>

@if (Model.FeaturedProject is { } featuredProject && Model.CurrentPage == 1 && string.IsNullOrWhiteSpace(Model.SearchTerm) && string.IsNullOrWhiteSpace(Model.Tag))
{
    <a asp-page="/Project" asp-route-slug="@featuredProject.Slug" class="featured-card">
        <div class="featured-card__inner">
            <div class="featured-card__body">
                @if (Model.FeaturedCoverImageUrl is not null)
                {
                    <img class="featured-card__cover" src="@Model.FeaturedCoverImageUrl" alt="@featuredProject.Title" />
                }
                <span class="featured-card__badge">Featured</span>
                <p class="featured-card__category">@(featuredProject.Category?.Name ?? "Project")</p>
                <h2 class="featured-card__title">@featuredProject.Title</h2>
                <p class="featured-card__summary">@featuredProject.Summary</p>
                <div class="featured-card__meta">
                    @if (featuredProject.Tags.Count > 0)
                    {
                        <span class="featured-card__tags">@string.Join(" · ", featuredProject.Tags.Select(t => t.Name))</span>
                    }
                    <time datetime="@((featuredProject.PublishedAt ?? featuredProject.CreatedAt).ToString("yyyy-MM-dd"))">@(featuredProject.PublishedAt?.ToString("MMMM d, yyyy") ?? featuredProject.CreatedAt.ToString("MMMM d, yyyy"))</time>
                </div>
            </div>
            <div class="featured-card__arrow">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </div>
        </div>
    </a>
}

@if (Model.Projects.Count == 0)
{
    <div class="empty-state">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 7h10"/><path d="M7 12h10"/><path d="M7 17h6"/></svg>
        @if (hasFilters)
        {
            <p>No projects match your search/filter.</p>
            <a asp-page="/Index" class="btn btn-link">Clear filters</a>
        }
        else
        {
            <p>No published projects yet.</p>
        }
    </div>
}
else
{
    <div class="card-grid">
        @foreach (var project in Model.Projects)
        {
            <article class="card-item reveal-on-scroll">
                <a asp-page="/Project" asp-route-slug="@project.Slug" class="card-item__link">
                    <div class="card-item__inner">
                        @if (Model.CoverImageUrls[project.Id] is string coverUrl)
                        {
                            <img class="card-item__cover" src="@coverUrl" alt="@project.Title" />
                        }
                        <p class="card-item__category">@(project.Category?.Name ?? "Project")</p>
                        <h3 class="card-item__title">@project.Title</h3>
                        <p class="card-item__summary">@project.Summary</p>
                        @if (project.Tags.Count > 0)
                        {
                            <p class="card-item__tags">@string.Join(" · ", project.Tags.Select(t => t.Name))</p>
                        }
                        <div class="card-item__meta">
                            <time datetime="@((project.PublishedAt ?? project.CreatedAt).ToString("yyyy-MM-dd"))">@(project.PublishedAt?.ToString("MMMM d, yyyy") ?? project.CreatedAt.ToString("MMMM d, yyyy"))</time>
                            <svg class="card-item__arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                        </div>
                    </div>
                </a>
            </article>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="pagination" aria-label="Page navigation">
            <ul class="pagination__list">
                @if (Model.CurrentPage > 1)
                {
                    <li>
                        <a href="?page=@(Model.CurrentPage - 1)@(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "" : $"&q={Model.SearchTerm}")@(string.IsNullOrWhiteSpace(Model.Tag) ? "" : $"&tag={Model.Tag}")"
                           class="pagination__link pagination__link--prev" aria-label="Previous page">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                        </a>
                    </li>
                }
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    @if (i == 1 || i == Model.TotalPages || Math.Abs(i - Model.CurrentPage) <= 1)
                    {
                        <li>
                            <a href="?page=@i@(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "" : $"&q={Model.SearchTerm}")@(string.IsNullOrWhiteSpace(Model.Tag) ? "" : $"&tag={Model.Tag}")"
                               class="pagination__link @(i == Model.CurrentPage ? "pagination__link--active" : "")">@i</a>
                        </li>
                    }
                    else if (Math.Abs(i - Model.CurrentPage) == 2)
                    {
                        <li class="pagination__ellipsis">…</li>
                    }
                }
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li>
                        <a href="?page=@(Model.CurrentPage + 1)@(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "" : $"&q={Model.SearchTerm}")@(string.IsNullOrWhiteSpace(Model.Tag) ? "" : $"&tag={Model.Tag}")"
                           class="pagination__link pagination__link--next" aria-label="Next page">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                        </a>
                    </li>
                }
            </ul>
            <p class="pagination__info">Page @Model.CurrentPage of @Model.TotalPages · @Model.TotalProjects @(Model.TotalProjects == 1 ? "project" : "projects")</p>
        </nav>
    }
}

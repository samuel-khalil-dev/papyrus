@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy";
}
<div class="article-layout">
    <article class="article-content">
        <header class="article-header">
            <h1 class="article-header__title">@ViewData["Title"]</h1>
            <p class="article-header__subtitle">A clear summary of how this site handles information.</p>
        </header>
        <div class="article-content__prose">
            <h2>Information we collect</h2>
            <p>Papyrus is a public portfolio site. We do not require an account or intentionally collect sensitive personal information. Standard server logs may contain your IP address, browser details, requested URL, and timestamp for security and reliability.</p>
            <h2>Cookies and analytics</h2>
            <p>The site stores your theme preference locally in your browser. We do not use advertising cookies or sell personal information. If analytics or other third-party services are added, this policy will be updated before they are enabled.</p>
            <h2>External links</h2>
            <p>Links to repositories, demos, and related sites are operated by third parties and are governed by their own privacy policies.</p>
            <h2>Contact</h2>
            <p>For privacy questions or requests, use the contact method provided on the site owner’s public profile.</p>
        </div>
    </article>
</div>

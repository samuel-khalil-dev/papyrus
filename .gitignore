# Build output
[Bb]in/
[Oo]bj/
artifacts/
**/node_modules/
**/dist/
*.dll
*.exe
*.pdb

# TypeScript / Node tooling caches
*.tsbuildinfo
.vite/
.eslintcache

# Visual Studio and VS Code local state
.vs/
# Only the shareable VS Code configuration is tracked; all other local state is not.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.user
*.userosscache
*.suo
*.rsuser
*.sln.docstates

# JetBrains Rider / ReSharper
.idea/
_ReSharper*/
*.DotSettings.user

# Test and coverage output
TestResults/
coverage/
*.coverage
*.coveragexml

# Playwright output
test-results/
playwright-report/
blob-report/

# Aspire and local tooling state
.aspire/
.dcp/
*.http.user

# NuGet and generated package files
*.nupkg
*.snupkg
packages/
.nuget/

# Strong-name keys and certificates (secrets)
*.snk
*.pfx
*.p12
*.key

# Local environment and secrets
.env
.env.*
!.env.example
appsettings.Local.json
appsettings.*.Local.json
appsettings.local.json
appsettings.*.local.json
secrets.json

# Local databases and database tooling files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.mdf
*.ldf

# Uploaded media (keep the directory marker tracked)
**/wwwroot/media/*
!**/wwwroot/media/.gitkeep

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log
logs/
npm-debug.log*
yarn-error.log
pnpm-debug.log*

# Transient / editor backup files
*.orig
*.rej
*.bak
*.tmp
*.temp
*.swp

# Internal / local-only
#
# Agent guidance (AGENTS.md) is deliberately NOT ignored: it is the primary
# contract for coding agents and is reviewed like any other tracked document.
# Local-only tooling directories stay ignored.
.kilo/
ops/*
!ops/observability/
plans/

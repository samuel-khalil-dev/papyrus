FROM node:26 AS admin-ui-build
WORKDIR /ui
COPY src/Papyrus.Admin.UI/package.json src/Papyrus.Admin.UI/package-lock.json ./
RUN npm ci
COPY src/Papyrus.Admin.UI/ ./
RUN npm run build

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY Papyrus.sln ./
COPY src/Papyrus.Api.Admin/Papyrus.Api.Admin.csproj Papyrus.Api.Admin/
COPY src/Papyrus.Infrastructure/Papyrus.Infrastructure.csproj Papyrus.Infrastructure/
COPY src/Papyrus.Core/Papyrus.Core.csproj Papyrus.Core/
COPY src/Papyrus.ServiceDefaults/Papyrus.ServiceDefaults.csproj Papyrus.ServiceDefaults/
COPY src/Papyrus.Application/Papyrus.Application.csproj Papyrus.Application/
COPY src/Papyrus.Contracts/Papyrus.Contracts.csproj Papyrus.Contracts/
RUN dotnet restore Papyrus.Api.Admin/Papyrus.Api.Admin.csproj
COPY Directory.Build.props ./
COPY src/Papyrus.Api.Admin/ Papyrus.Api.Admin/
COPY src/Papyrus.Infrastructure/ Papyrus.Infrastructure/
COPY src/Papyrus.Core/ Papyrus.Core/
COPY src/Papyrus.ServiceDefaults/ Papyrus.ServiceDefaults/
COPY src/Papyrus.Application/ Papyrus.Application/
COPY src/Papyrus.Contracts/ Papyrus.Contracts/
COPY --from=admin-ui-build /ui/dist Papyrus.Api.Admin/wwwroot/admin
RUN dotnet publish Papyrus.Api.Admin/Papyrus.Api.Admin.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080
COPY --from=build /app/publish .
RUN mkdir -p /data/media && chown -R $APP_UID:$APP_UID /data/media
USER $APP_UID
ENTRYPOINT ["dotnet", "Papyrus.Api.Admin.dll"]
